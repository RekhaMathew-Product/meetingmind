PORT=3001

# Recall.ai — https://www.recall.ai/
RECALL_API_KEY=your_recall_api_key_here
RECALL_API_BASE=https://api.recall.ai/api/v1

# Anthropic Claude API — agenda checks + meeting summary
# https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# TinyFish — web Fetch + Search for live meeting context
# https://www.tinyfish.ai/
TINYFISH_API_KEY=your_tinyfish_api_key_here
TINYFISH_API_BASE=https://api.tinyfish.ai/v1

# Gradium TTS — https://gradium.ai/
GRADIUM_API_KEY=your_gradium_api_key_here
GRADIUM_API_BASE=https://api.gradium.ai/v1
GRADIUM_VOICE_ID=your_gradium_voice_id_here  # check https://gradium.ai/docs for available voice IDs

# Public URL for serving audio files (e.g. ngrok tunnel in dev)
PUBLIC_BASE_URL=https://your-ngrok-url.ngrok.io
